# Dependencies
node_modules/
.pnpm-store/
.pnpm-store-local/
.pnpm-tmp/
.trae/

# Build output
dist/
releases/
*.crx
*.pem
*.zip

# Vite / TypeScript caches
.vite/
*.tsbuildinfo

# Test output
coverage/

# Local scratch: scripts & data produced during manual testing (never commit)
tmp/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local secrets. API keys belong in the extension's Settings UI (stored in
# chrome.storage.local), never in a file that could be committed.
.env
.env.*
!.env.example
