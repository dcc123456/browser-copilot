{
  "name": "browser-copilot",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "A side-panel browser assistant that can read and act on the page you are looking at. Works with any OpenAI-compatible model.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "vite build && node scripts/build-zip.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.312",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.0"
  }
}
