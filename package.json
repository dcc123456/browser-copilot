{
  "name": "browser-copilot",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "0.6.1",
  "type": "module",
  "description": "A side-panel browser assistant that can read and act on the page you are looking at. Works with any OpenAI-compatible model.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:no-ocr": "vite build --mode no-ocr",
    "package": "vite build && node scripts/build-zip.mjs ocr && vite build --mode no-ocr && node scripts/build-zip.mjs no-ocr",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "server:start": "pnpm --filter browser-copilot-runner start",
    "server:dev": "pnpm --filter browser-copilot-runner dev",
    "server:build": "pnpm --filter browser-copilot-runner build",
    "server:web:dev": "pnpm --filter browser-copilot-runner web:dev",
    "server:typecheck": "pnpm --filter browser-copilot-runner typecheck",
    "server:test": "pnpm --filter browser-copilot-runner test",
    "server:smoke": "pnpm --filter browser-copilot-runner smoke",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@xyflow/react": "^12.11.5",
    "lucide-react": "^1.37.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.0.312",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tesseract.js-core": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
