{
  "name": "browser-copilot-runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone server runner: executes Browser Copilot workflows headlessly with Playwright, reusing the extension's pure engine.",
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "croner": "^9.0.0",
    "fastify": "^5.0.0",
    "playwright": "1.59.1",
    "tesseract.js": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
