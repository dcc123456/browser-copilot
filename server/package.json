{
  "name": "browser-copilot-runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone server runner: executes Browser Copilot workflows headlessly with Playwright, reusing the extension's pure engine.",
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "web:dev": "vite",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "croner": "^9.0.0",
    "fastify": "^5.0.0",
    "playwright": "1.59.1",
    "tesseract.js": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.0"
  }
}
