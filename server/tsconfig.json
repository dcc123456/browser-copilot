{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "chrome"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "../src/types/**/*.d.ts",
    "../src/background/workflow-engine/engine.ts",
    "../src/background/workflow-engine/loop-breakpoint.ts",
    "../src/inpage/kernel.ts",
    "../src/inpage/kernel-version.ts",
    "../src/lib/**/*.ts"
  ]
}
